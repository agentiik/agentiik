{
  "workflow": "monthly-invoicing",
  "commit": "a3f9c1e04b7d2e8f6a1c3b5d7e9f0a2b4c6d8e0f",
  "includes": [
    {
      "path": "common-bricks.yaml"
    },
    {
      "workflow": "finance/common",
      "ref": "v2.1.0",
      "commit": "c41d9e2a7b3f5e8d1c0a9b6e4f2d8c7a5b3e1f09"
    }
  ],
  "inputs": {
    "orders": {
      "schema": {
        "$ref": "./schemas/order.json"
      },
      "required": true
    },
    "cycle": {
      "schema": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}$"
      },
      "default": "2026-01"
    }
  },
  "outputs": {
    "archived": {
      "from": {
        "step": "archive",
        "port": "out"
      },
      "retain": {
        "for": "90d"
      }
    },
    "charged": {
      "from": {
        "step": "charge",
        "port": "ok"
      }
    },
    "invoiced": {
      "from": {
        "step": "total",
        "port": "ok"
      }
    },
    "rejected": {
      "from": {
        "step": "charge",
        "port": "rejected"
      },
      "retain": {
        "for": "24h",
        "fetches": 1
      }
    }
  },
  "on": {
    "schedule": [
      {
        "cron": "0 6 1 * *",
        "timezone": "Europe/Paris"
      }
    ]
  },
  "secrets": [
    "billing_api"
  ],
  "timeout": "6h",
  "retain": "7d",
  "order": [
    "split",
    "charge",
    "total",
    "archive"
  ],
  "steps": {
    "split": {
      "kind": "brick",
      "image": "ghcr.io/acme/agk-split@sha256:6c3e2a1f09d8b7c6e5f4d3c2b1a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2",
      "brick": {
        "name": "split-orders",
        "version": "0.1.0"
      },
      "inputs": {
        "orders": "${{ workflow.inputs.orders }}"
      },
      "outputs": [
        "ok"
      ],
      "retain": "7d",
      "idempotent": true
    },
    "charge": {
      "kind": "brick",
      "image": "ghcr.io/acme/agk-charge@sha256:2b8d41c07e5f3a9b6c1d0e2f4a8b7c6d5e3f1a09b8c7d6e5f4a3b2c1d0e9f8a7",
      "brick": {
        "name": "charge-order",
        "version": "0.1.0"
      },
      "needs": [
        {
          "step": "split",
          "port": "ok",
          "as": "in"
        }
      ],
      "outputs": [
        "ok",
        "rejected"
      ],
      "strategy": {
        "fan_out": "item",
        "max_parallel": 3
      },
      "retry": {
        "max": 3,
        "on": [
          "transient"
        ]
      },
      "timeout": "2m",
      "retain": "7d",
      "network": "egress",
      "egress": {
        "allow": [
          "api.billing.example.com:443"
        ]
      },
      "resources": {
        "cpu": "0.5",
        "memory": "256Mi"
      },
      "secrets": [
        "billing_api"
      ],
      "idempotent": false,
      "extends": [
        ".api-brick"
      ]
    },
    "total": {
      "kind": "brick",
      "image": "ghcr.io/acme/agk-total@sha256:e1d2c3b4a5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90",
      "brick": {
        "name": "total-charges",
        "version": "0.1.0"
      },
      "needs": [
        {
          "step": "charge",
          "port": "ok",
          "as": "charges"
        },
        {
          "step": "charge",
          "port": "rejected",
          "as": "charges"
        }
      ],
      "outputs": [
        "ok"
      ],
      "retain": "7d",
      "idempotent": true,
      "workflow": {
        "workflow": "finance/totals",
        "ref": "v1.0.0"
      }
    },
    "archive": {
      "kind": "script",
      "image": "alpine:3.21@sha256:5f8b1e1ad4503f1abb00387333cc6ebac7c77193d6adf4c3917794e7102dc704",
      "needs": [
        {
          "step": "total",
          "port": "ok",
          "as": "in"
        }
      ],
      "outputs": [
        "out"
      ],
      "retain": "7d",
      "script": [
        "agk items > /tmp/items.json",
        "agk emit out --from /tmp/items.json"
      ],
      "shell": [
        "/bin/sh",
        "-e"
      ],
      "idempotent": true
    }
  }
}
