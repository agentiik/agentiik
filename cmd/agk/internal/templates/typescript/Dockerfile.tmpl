# Node, which runs TypeScript as it is, and the brick's two files, as the account the manifest
# declares. Pin the base image by digest before publishing, so that the brick changes only when its
# source does.
FROM node:24-alpine
COPY brick.yaml /agk/brick.yaml
COPY main.ts brick.ts /opt/brick/
USER 65532:65532
ENTRYPOINT ["node", "/opt/brick/main.ts"]
