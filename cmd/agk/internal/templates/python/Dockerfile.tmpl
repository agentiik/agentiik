# Python and the brick's two files, run as the account the manifest declares. Pin the base image by
# digest before publishing, so that the brick changes only when its source does.
FROM python:3.13-alpine
COPY brick.yaml /agk/brick.yaml
COPY main.py agentiik_brick.py /opt/brick/
USER 65532:65532
ENTRYPOINT ["python3", "/opt/brick/main.py"]
